# Copy to .env and fill in. NEVER commit .env.
TELEGRAM_BOT_TOKEN=            # from @BotFather (secret)
TELEGRAM_OWNER_ID=             # leave empty, then send /start to the bot to learn yours
OWNER_PHANTOM_ADDRESS=         # your Phantom Solana address (public, safe to share)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# STATE_FILE=data/state.json   # where the bot remembers what it has already seen

# Bot trading wallet. Stays on devnet (free test money) until Phase 4.
BOT_WALLET_NETWORK=devnet
# Filled in automatically by: npm run wallet:create
BOT_KEY_PASSPHRASE=

# Optional
# BOT_WALLET_RPC_URL=          # defaults to public devnet/mainnet for BOT_WALLET_NETWORK
# JUPITER_API_URL=https://lite-api.jup.ag
# REPORT_HOUR_UTC=20           # daily report time
# BOT_WALLET_FILE=data/bot-wallet.enc.json
# DB_FILE=data/buttonwood.db
